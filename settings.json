{
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(*)",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_evaluate"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./*.pem)",
      "Read(./*.key)",
      "Bash(printenv)",
      "Bash(env)",
      "Bash(set)",
      "Bash(export)",
      "Bash(setx *)",
      "Bash(cat .env)",
      "Bash(cat .env.*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "additionalDirectories": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/english_feedback_reminder.sh",
            "timeout": 3
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/eric.liao/.orca/agent-hooks/claude-hook.cmd",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check_dangerous.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check_dangerous.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check_dangerous.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check_dangerous.sh"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check_dangerous.sh"
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check_dangerous.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/eric.liao/.orca/agent-hooks/claude-hook.cmd",
            "timeout": 10
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/sync_plugins_md.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/jira-backfill.py commit",
            "if": "Bash(git *commit*)",
            "timeout": 20,
            "statusMessage": "Backfilling commit link to JIRA..."
          },
          {
            "type": "command",
            "command": "python ~/.claude/hooks/jira-backfill.py mr",
            "if": "Bash(*mr create*)",
            "timeout": 20,
            "statusMessage": "Backfilling MR link to JIRA..."
          }
        ]
      },
      {
        "matcher": "mcp__.*__create_merge_request",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/jira-backfill.py mr",
            "timeout": 20,
            "statusMessage": "Backfilling MR link to JIRA..."
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/eric.liao/.orca/agent-hooks/claude-hook.cmd",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/eric.liao/.orca/agent-hooks/claude-hook.cmd",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/eric.liao/.orca/agent-hooks/claude-hook.cmd",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/eric.liao/.orca/agent-hooks/claude-hook.cmd",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/eric.liao/.orca/agent-hooks/claude-hook.cmd",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/eric.liao/.orca/agent-hooks/claude-hook.cmd",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/eric.liao/.orca/agent-hooks/claude-hook.cmd",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/eric.liao/.orca/agent-hooks/claude-hook.cmd",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/eric.liao/.orca/agent-hooks/claude-hook.cmd",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/eric.liao/.orca/agent-hooks/claude-hook.cmd",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/eric.liao/.orca/agent-hooks/claude-hook.cmd",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "ascii-art-0@chuunibiyou-system": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "gitkraken-hooks@gitkraken": true,
    "security-guidance@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "postman@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "gitkraken": {
      "source": {
        "source": "directory",
        "path": "C:\\Users\\eric.liao\\.claude\\plugins\\marketplaces\\gitkraken"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true
}
